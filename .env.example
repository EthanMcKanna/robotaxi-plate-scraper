# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# Tip: run `npm run setup` for an interactive walkthrough.

# Gemini API (for vision/plate extraction)
GEMINI_API_KEY=your_gemini_api_key

# Supabase (same as main app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bot user ID (run: npm run seed:bot to create)
BOT_USER_ID=uuid-of-bot-user

# Cloudflare Worker dual-write (phase one keeps Supabase as rollback)
ROBOTAXI_INGEST_URL=https://robotaxi-api-v1-preview.example.workers.dev
ROBOTAXI_INGEST_SECRET=replace-with-producer-specific-hmac-secret
ROBOTAXI_INGEST_REQUIRED=false

# ===========================================
# SCRAPER SETTINGS
# ===========================================

# How far back to look for posts (in hours)
LOOKBACK_HOURS=2

# Maximum scrapers to run in parallel
MAX_CONCURRENT_SCRAPERS=1

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ===========================================
# SCRAPER FEATURE FLAGS
# Enable/disable individual scrapers (true/false)
# ===========================================

# Reddit scraper - WORKING (uses JSON API)
ENABLE_REDDIT=true
